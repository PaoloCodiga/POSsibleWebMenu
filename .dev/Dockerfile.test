FROM odoo:19.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg && curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o /tmp/chrome.deb && apt-get install -y /tmp/chrome.deb && rm -f /tmp/chrome.deb && pip3 install --break-system-packages --no-cache-dir websocket-client && rm -rf /var/lib/apt/lists/*
USER odoo
