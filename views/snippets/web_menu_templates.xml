<odoo>
  <template id="web_menu_fragment" name="POSsible Web Menu fragment">
    <div t-attf-class="o_possible_web_menu o_possible_web_menu_#{config['layout']}">
      <t t-foreach="groups" t-as="group"><section class="o_possible_web_menu_category"><h3 class="o_possible_web_menu_category_title" t-esc="group['category'].name if group['category'] else group['name']"/><ul class="o_possible_web_menu_products"><t t-foreach="group['products']" t-as="product"><li class="o_possible_web_menu_product"><div class="o_possible_web_menu_product_info"><span class="o_possible_web_menu_product_name" t-esc="product.display_name"/><small t-if="config['show_internal_reference'] and product.default_code" class="o_possible_web_menu_reference" t-esc="product.default_code"/><p t-if="config['show_description'] and (product.public_description or product.description_sale)" class="o_possible_web_menu_description" t-esc="env['possible.web.menu.renderer']._get_product_description(product)"/></div><span class="o_possible_web_menu_leader" aria-hidden="true"/><span class="o_possible_web_menu_price" t-out="prices[product.id]" t-options="{'widget': 'monetary', 'display_currency': currency}"/></li></t></ul></section></t>
    </div>
  </template>
</odoo>
